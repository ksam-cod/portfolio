# Copy to .env and edit
DATABASE_URL=postgres://postgres:postgres@localhost:5432/portfolio
# Set to true for hosted databases that require TLS (Neon, Supabase, RDS...)
PGSSL=false
PORT=3000
# Required for admin endpoints. Min 16 chars. Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=
